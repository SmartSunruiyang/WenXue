{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": ".",
		"paths": {
			"@wenxue/client-operations": ["../../packages/client-operations/index.d.ts"]
		},
		"strict": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node", "vitest/globals"]
	},
	"include": ["src/**/*.mjs", "src/**/*.ts"]
}
