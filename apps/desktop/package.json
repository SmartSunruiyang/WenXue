{
	"name": "desktop",
	"private": true,
	"version": "0.0.1-beta",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"dist": "pnpm build && electron-builder --publish never",
		"dist:mac": "pnpm build && electron-builder --mac --publish never",
		"dist:win": "pnpm build && electron-builder --win --publish never",
		"preview": "electron-vite preview",
		"typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
		"test": "vitest run && node --test scripts/*.test.mjs",
		"fetch-browser": "tsx scripts/fetch-browser.ts",
		"generate-icons": "swift scripts/generate-app-icons.swift",
		"generate-icons:win": "swift scripts/generate-app-icons.swift --windows"
	},
	"dependencies": {
		"@puppeteer/browsers": "^3.0.4",
		"@cloudbase/js-sdk": "^2.30.0",
		"@wenxue/client-operations": "workspace:*",
		"electron-log": "^5.2.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.0.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.3.4",
		"electron": "^33.2.0",
		"electron-builder": "^26.0.12",
		"electron-vite": "^2.3.0",
		"lucide-react": "^1.16.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.22.4",
		"typescript": "^5.7.0",
		"vite": "^5.4.21",
		"vitest": "^2.1.0",
		"yaml": "^2.8.1"
	}
}
